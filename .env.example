# Yandex Foundation Models API
YANDEX_API_KEY=your_api_key_here
YANDEX_MODEL=gpt-3.5-turbo
YANDEX_BASE_URL=https://llm.api.cloud.yandex.net/v1
YANDEX_FOLDER_ID=your_folder_id_here
YANDEX_PROXY_URL=  # Опционально: если Yandex API требует прокси (например, http://proxy:8080)

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
OWNER_CHAT_ID=your_telegram_numeric_id
TELEGRAM_PROXY_URL=  # Опционально: http://, https://, socks4:// или socks5://. Формат stg:// не поддерживается aiogram напрямую

# Настройки
BUFFER_WAIT_SECONDS=20
MAX_HISTORY_MESSAGES=5
DB_PATH=logs/assistant.db
